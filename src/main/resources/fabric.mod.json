{
  "schemaVersion": 1,
  "id": "better-bundle",
  "version": "${version}",
  "name": "BetterBundleHUD Continued",
  "description": "Adds a side panel to the inventory for quick bundle access",
  "authors": [
    "zeroowo24 (original author)",
    "Lulukai (continuation maintainer)"
  ],
  "contact": {
    "sources": "https://github.com/Lulukai/BetterBundleHUDMod",
    "issues": "https://github.com/Lulukai/BetterBundleHUDMod/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/better-bundle/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "betterbundle.BetterBundleMod"
    ]
  },
  "accessWidener": "better-bundle.accesswidener",
  "mixins": [
    {
      "config": "better-bundle.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": ">=0.165.0+26.3"
  }
}
